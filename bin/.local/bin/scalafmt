#!/usr/bin/env bash

set -euo pipefail

conf="$(git rev-parse --show-toplevel 2>/dev/null || pwd)/.scalafmt.conf"
version=$(awk -F'[="[:space:]]+' '/^[[:space:]]*version[[:space:]]*=/ {print $2; exit}' "$conf" | tr -d '\r')
bin="$HOME/.local/share/scalafmt/$version/scalafmt"

if [ ! -x "$bin" ]; then
  mkdir -p "$(dirname "$bin")"
  curl -L -o "$bin" "https://github.com/scalameta/scalafmt/releases/download/v${version}/scalafmt-macos"
  chmod +x "$bin"
fi

exec "$bin" "$@"